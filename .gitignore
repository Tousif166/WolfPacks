.kotlin/

# node.js
#
node_modules/
npm-debug.log
yarn-error.log

# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle
*.apk

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Environment variables (react-native-config) — never commit real secrets
.env
.env.*.local
# Server-only credentials for local tooling (migrations, admin scripts).
# Deliberately NOT named `.env`, because android/app/build.gradle applies react-native-config's
# dotenv.gradle, which compiles every key in `.env` into the APK where it is extractable.
.env.tooling.local

# Downloaded CLI binaries (supabase CLI is ~54 MB — fetched, not committed)
tools/

# Gradle build transcripts from local release builds
build-release*.log

# Schema/data dumps pulled from the hosted project for inspection — may contain live data
remote-*-dump.sql
live-check.sql
remote-after-push.sql

# Pre-revert snapshots (safety net for the MMKV rollback; not part of the project)
.revert-backup/

# Python bytecode from the ml/ training scripts
__pycache__/
*.pyc

# Supabase CLI local state — link target, pooler host, org id, tool versions.
# Machine-specific, not project source, and it leaks your database host.
supabase/.temp/

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Contains release signing passwords (SAHAKAR_RELEASE_*) — keep out of version control.
android/gradle.properties

# ML pipeline
# The generated dataset is reproducible from ml/generate_dataset.py, so it is not committed.
# src/data/forecastModel.json IS committed — the app imports it at runtime.
ml/data/
ml/__pycache__/
ml/.venv/
ml/.parity_harness.js
ml/.inference_harness.js
ml/.inference_vectors.json
