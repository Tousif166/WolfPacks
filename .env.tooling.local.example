# =============================================================================
# SERVER-ONLY credentials, for local tooling. Copy to `.env.tooling.local`.
# =============================================================================
#
# WHY THIS FILE EXISTS SEPARATELY FROM `.env`
# -------------------------------------------
# `android/app/build.gradle` applies react-native-config's dotenv.gradle, which compiles EVERY key
# in `.env` into the Android build. Those values end up inside the shipped APK and are extractable
# by anyone who has it — that is not a theory, it is how GROQ_API_KEY was found in the release
# bundle while auditing this project.
#
# A service-role key bypasses Row Level Security completely. Putting one in `.env` would mean
# shipping full read/write access to every user's data inside a file you hand to other people. So
# these credentials live here instead:
#
#   * this filename is NOT `.env`, so dotenv.gradle never reads it
#   * it matches `.env.tooling.local` in .gitignore, so it is never committed
#   * nothing in src/ imports it — it is only for scripts run on your own machine
#
# `npm run check:env` enforces the separation and fails if any of these leak into `.env`.
#
#
# WHAT YOU ACTUALLY NEED, AND WHEN
# --------------------------------
# To APPLY MIGRATIONS you do NOT need the service-role key. The Supabase CLI authenticates with a
# personal access token and connects to Postgres directly:
#
#     supabase login                      # opens a browser, stores the token in ~/.supabase
#     supabase link --project-ref <ref>   # prompts for the database password
#     supabase db push                    # applies supabase/migrations/*.sql
#
# Those credentials are kept in your home directory by the CLI, not in this repo at all — which is
# why the two variables below are optional and commented out by default.
# =============================================================================


# The project ref from your dashboard URL: https://supabase.com/dashboard/project/<THIS>
# Not a secret, but keeping it here means scripts don't have to hardcode it.
SUPABASE_PROJECT_REF=your-project-ref


# ---- Optional. Only uncomment if a script genuinely needs to bypass RLS. ----
#
# Service-role key: Dashboard -> Project Settings -> API -> service_role (or the newer
# `sb_secret_...` secret key). Treat this like a root password.
#
# NEVER: put it in `.env`, commit it, paste it into a chat or issue, or reference it from any file
# under src/. If it is ever exposed, rotate it immediately in the dashboard.
#
# SUPABASE_SERVICE_ROLE_KEY=


# Database password, if you prefer non-interactive `supabase db push` over the CLI prompt.
# SUPABASE_DB_PASSWORD=
