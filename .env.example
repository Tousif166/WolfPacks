# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real keys.
#
# These are read at native-build time by react-native-config (Config.FOO_BAR in JS)
# NOT by `process.env` / `import.meta.env` — this is not Vite.
#
# ############################################################################
# EVERY KEY IN `.env` SHIPS INSIDE THE APK AND IS EXTRACTABLE.
#
# android/app/build.gradle applies react-native-config's dotenv.gradle, which compiles this whole
# file into the Android build. Assume anything here is public the moment you share a build.
#
# So `.env` is ONLY for keys the app itself must call at runtime. Server-only credentials —
# a Supabase service-role key, the database password, a management access token — must NEVER be
# added here. A service-role key bypasses Row Level Security, so leaking one exposes every user's
# data. Put those in `.env.tooling.local` instead (see .env.tooling.local.example).
#
# `npm run check:env` enforces this and fails if a server-only secret appears in .env.
# ############################################################################

# Supabase project (auth only — see src/services/supabase.js in the web app for why)
SUPABASE_URL=YOUR_PROJECT_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Groq cloud AI key — used by src/services/aiService.js (BookingScreen AI diagnosis, future chat).
# Get a free key at https://console.groq.com/keys (starts with gsk_). Free tier is generous
# (~1K RPM on gpt-oss-20b) vs Gemini's low daily cap — this is why we migrated off Gemini.
# SECURITY: like any react-native-config value, this key is embedded in the shipped APK and is
# extractable by anyone with the APK. See MIGRATION_NOTES.md for the recommendation to proxy
# Groq calls through a Supabase Edge Function so the key never leaves the server.
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Gemini API key — LEGACY (superseded by GROQ_API_KEY in Phase 9). Kept only so the web-app
# parity is documented; the RN app no longer reads this. Safe to leave as the placeholder.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Google Maps SDK for Android key — used by LiveTrackingMap (Phase 10) and
# android/app/src/main/AndroidManifest.xml. Restrict this key in Google Cloud Console to
# package name com.sahakarsevamobile + your debug/release SHA-1 fingerprints.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
